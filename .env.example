# =============================================================================
# Variáveis de ambiente — PRODUÇÃO (Exemplo)
# =============================================================================
# INSTRUÇÕES:
#   1. No servidor de produção, este arquivo será copiado automaticamente para:
#      /home/ghactions/projeto-eq17/.env se não existir.
#   2. Preencha os valores reais de usuário e senha do banco no .env do servidor.
#   3. A variável APP_IMAGE é atualizada automaticamente pelo GitHub Actions.
# =============================================================================

# Imagem Docker da aplicação (atualizada automaticamente pelo CI/CD a cada deploy)
APP_IMAGE=ghcr.io/des-sist-corp-ufpb/projeto-eq17:latest

# Banco de dados (Produção)
DATABASE_URL=jdbc:postgresql://postgres:5432/eq17
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=sua-senha-do-banco-aqui

# Nome do container (único para evitar colisões no servidor compartilhado)
CONTAINER_NAME=eq17-app

# Porta exposta no Host (evita colisões com outras equipes)
HOST_PORT=8017

# Domínio para roteamento automático pelo Caddy
APP_DOMAIN=eq17.dsc.rodrigor.com

# Nome da rede docker externa compartilhada com Caddy e Postgres
DOCKER_NETWORK=caddy

# Google OAuth2
GOOGLE_CLIENT_ID=seu-client-id-aqui
GOOGLE_CLIENT_SECRET=seu-client-secret-aqui
